node_modules
out
.env

# Captures are re-made by the script from a running site, so they are build
# output rather than source.
public/captures

# A signed-in browser profile for capturing the admin. It is a live session,
# not a secret this repo should carry. Delete it to sign the profile out.
.auth

# Human-recorded footage. Kept out of git because it is large and binary and
# gets re-shot, not edited. Back it up wherever the rest of the raw video lives.
public/footage

# The OBS scene collection is generated by scripts/make-obs-scenes.mjs and
# contains a machine-specific camera id once somebody has picked one.
obs/

# public/generated is deliberately NOT ignored. Those files cost money to make
# and the cache only works if they travel with the repo. Committing them means a
# render on another machine, or in CI, pays nothing and produces the identical
# video.
